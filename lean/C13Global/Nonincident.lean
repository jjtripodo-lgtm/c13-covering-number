import C13Global.BasicData
namespace C13.Global
set_option Elab.async false
set_option maxHeartbeats 0
set_option maxRecDepth 100000
structure Nonincident where
  point : Point
  mask : Mask
  checked : listMask (blockUniverse.filter (fun b => !b.getLsbD point.val)) = mask
def nonincident00 : Nonincident := ⟨0,,by decide +kernel⟩
def nonincident01 : Nonincident := ⟨1,,by decide +kernel⟩
def nonincident02 : Nonincident := ⟨2,,by decide +kernel⟩
def nonincident03 : Nonincident := ⟨3,,by decide +kernel⟩
def nonincident04 : Nonincident := ⟨4,,by decide +kernel⟩
def nonincident05 : Nonincident := ⟨5,,by decide +kernel⟩
def nonincident06 : Nonincident := ⟨6,,by decide +kernel⟩
def nonincident07 : Nonincident := ⟨7,,by decide +kernel⟩
def nonincident08 : Nonincident := ⟨8,,by decide +kernel⟩
def nonincident09 : Nonincident := ⟨9,,by decide +kernel⟩
def nonincident10 : Nonincident := ⟨10,,by decide +kernel⟩
def nonincident11 : Nonincident := ⟨11,,by decide +kernel⟩
def nonincident12 : Nonincident := ⟨12,,by decide +kernel⟩
def nonincidentList : List Nonincident := [nonincident00,nonincident01,nonincident02,nonincident03,nonincident04,nonincident05,nonincident06,nonincident07,nonincident08,nonincident09,nonincident10,nonincident11,nonincident12]
def nonincidentAt (q : Point) : Nonincident := nonincidentList[q.val]'(by change q.val < 13; exact q.isLt)
theorem nonincident_point (q : Point) : (nonincidentAt q).point = q := by
  have h : ∀ i : Fin 13, (nonincidentAt i).point = i := by decide +kernel
  exact h q
theorem nonincident_bit (q : Point) (b : Code) (hb : b ∈ blockUniverse)
    (hq : b.getLsbD q.val = false) : ((nonincidentAt q).mask).testBit b.toNat = true := by
  rw [← (nonincidentAt q).checked,listMask_bit,nonincident_point]
  simp only [decide_eq_true_eq,List.mem_filter,Bool.not_eq_true']
  exact ⟨hb,hq⟩
end C13.Global
