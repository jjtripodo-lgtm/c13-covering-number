def validBlockB (c : Code) : Bool := decide
    (decodeTyped c ⊆ Finset.univ.erase hole ∧ (decodeTyped c).card = 7)

theorem blockCodes_chain : blockCodes.IsChain (fun a b => a.toNat < b.toNat) := by decide +kernel

theorem blockCodes_card : blockCodes.toFinset.card = 792 := by
  have hp : blockCodes.Pairwise (fun a b => a.toNat < b.toNat) := List.isChain_iff_pairwise.mp blockCodes_chain
  have hn : blockCodes.Nodup := hp.imp (by intro a b h he; subst b; exact (Nat.lt_irrefl _ h))
  rw [List.toFinset_card_of_nodup hn]
  decide
